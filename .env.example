# ==============================================================================
#                     NODEDROPS.XYZ — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` or `.env.local` for local development:
#    cp .env.example .env
# 2. In production, configure these variables in your deployment dashboard
#    (e.g., Vercel, Railway, Coolify, Docker, or AWS ECS).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: managed automatically by Next.js ("development" during dev, "production" during build)
# NODE_ENV="development"

# Server Port (default: 3001)
PORT=3001

# Public Canonical URL (No trailing slash)
# Local: http://localhost:3001 | Production: https://nodedrops.xyz
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Public API Base Path
NEXT_PUBLIC_API_URL="/api"


# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE (TiDB Serverless / MySQL / Prisma)
# ------------------------------------------------------------------------------
# Primary MySQL / TiDB Cloud Connection String (TLS enabled)
# Format: mysql://<USER>.<RANDOM>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict
DATABASE_URL="mysql://root:password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/nodedrops?sslaccept=strict"

# Direct unpooled connection URL (used for Prisma migrations and CLI tooling)
DIRECT_URL="mysql://root:password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/nodedrops?sslaccept=strict"


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, SESSIONS & SECURITY
# ------------------------------------------------------------------------------
# Server-side cryptographic secret key for signing session tokens and JWTs
# Generate a secure key with: openssl rand -base64 48
SESSION_SECRET="change-this-to-a-cryptographically-secure-random-string-min-48-chars"

# Name of the HTTP-only authentication session cookie
SESSION_COOKIE_NAME="nodedrops_session"

# Session expiration time in days (default: 7)
SESSION_EXPIRY_DAYS=7

# Bcrypt password hashing salt rounds (default: 12)
BCRYPT_SALT_ROUNDS=12


# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR BOOTSTRAP CREDENTIALS
# ------------------------------------------------------------------------------
# Used for initial platform bootstrap and offline testing fallback
ADMIN_INIT_EMAIL="admin@nodedrops.xyz"
ADMIN_INIT_PASSWORD="NodeDrops2026!Admin"
ADMIN_INIT_NAME="Lead System Admin"


# ------------------------------------------------------------------------------
# 5. OAUTH SOCIAL AUTHENTICATION (Google, X / Twitter, GitHub)
# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3001/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# X (TWITTER) OAUTH 2.0 (Twitter Developer Portal > User Authentication Settings)
# Callback URL: http://localhost:3001/api/auth/oauth/x/callback
X_CLIENT_ID="your-x-client-id"
X_CLIENT_SECRET="your-x-client-secret"

# GITHUB OAUTH (GitHub > Settings > Developer settings > OAuth Apps)
# Authorization callback URL: http://localhost:3001/api/auth/oauth/github/callback
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"


# ------------------------------------------------------------------------------
# 6. RATE LIMITING & ANTI-ABUSE
# ------------------------------------------------------------------------------
# Enable or disable in-memory / distributed rate limiting (true / false)
RATE_LIMIT_ENABLED="true"

# Maximum allowed requests per time window
RATE_LIMIT_MAX_REQUESTS=60

# Rate limit time window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Optional: Upstash Redis (For multi-instance distributed rate limiting)
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"


# ------------------------------------------------------------------------------
# 7. MEDIA ASSETS & UPLOAD STORAGE
# ------------------------------------------------------------------------------
# Storage driver: 'local' (filesystem in ./public/uploads) or 's3' (S3 / R2)
UPLOAD_STORAGE_DRIVER="local"

# Local upload directory path
UPLOAD_LOCAL_PATH="./public/uploads"

# Maximum upload file size in Megabytes (default: 10)
UPLOAD_MAX_FILE_SIZE_MB=10

# Allowed MIME types for uploaded files
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp,image/svg+xml,image/gif"

# Optional: Cloudflare R2 / AWS S3 Configuration (when UPLOAD_STORAGE_DRIVER=s3)
# S3_BUCKET_NAME="nodedrops-assets"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_PUBLIC_DOMAIN="https://assets.nodedrops.xyz"


# ------------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAIL & ALERTS (SMTP / Resend / Telegram)
# ------------------------------------------------------------------------------
# Email service provider: 'smtp', 'resend', or 'none'
EMAIL_PROVIDER="none"

# SMTP Configuration (SendGrid, Postmark, AWS SES, or Resend SMTP)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="re_your_api_key_here"
EMAIL_FROM="NodeDrops Security <security@nodedrops.xyz>"

# Telegram Bot Alerts (Optional: Real-time telemetry alerts channel)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ALERTS_CHANNEL_ID="@nodedrops_telemetry"


# ------------------------------------------------------------------------------
# 9. LIVE WEB3 RPC ENDPOINTS (Optional: Network Uptime & Block Scanners)
# ------------------------------------------------------------------------------
# Public / Dedicated RPC endpoints for node block height & synchronization checks
NEXT_PUBLIC_ETH_SEPOLIA_RPC="https://rpc.sepolia.org"
NEXT_PUBLIC_CELESTIA_MOCHA_RPC="https://rpc-mocha.pops.one"
NEXT_PUBLIC_BERACHAIN_BARTIO_RPC="https://bartio.rpc.berachain.com"
NEXT_PUBLIC_MONAD_DEVNET_RPC="https://rpc-devnet.monad.xyz"


# ------------------------------------------------------------------------------
# 10. SITE METADATA & TELEMETRY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="NodeDrops.xyz"
NEXT_PUBLIC_SITE_DESCRIPTION="Run Nodes. Learn Web3. Explore Opportunities. Comprehensive production-grade node documentation, hardware checkers, and validator guides."
NEXT_PUBLIC_ENABLE_TELEMETRY="true"

# Optional: Analytics Measurement ID (Google Analytics / Plausible)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
