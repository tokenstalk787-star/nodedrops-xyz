# TiDB Cloud Starter MySQL connection string (TLS enabled)
# Format: mysql://<USER>.<RANDOM>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict
DATABASE_URL="mysql://root:password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/nodedrops?sslaccept=strict"

# Application Environment
NODE_ENV="development"

# Server-Side Cryptographic Session Secret (minimum 32 characters)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-string-in-production"

# Public Canonical URL
NEXT_PUBLIC_APP_URL="https://nodedrops.xyz"
